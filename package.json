{
  "name": "parentalcontrol",
  "version": "1.0.0",
  "description": "ParentalControl – panel limitu czasu komputera dla konta dziecka (Windows)",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:arm64": "electron-builder --win --arm64"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pl.parentalcontrol.panel",
    "productName": "ParentalControl",
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*", "resources/**/*"],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ParentalControl"
    }
  }
}
